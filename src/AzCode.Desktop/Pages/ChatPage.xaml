<UserControl x:Class="AzCode.Desktop.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 消息列表 -->
        <ListBox x:Name="ChatList"
                 Grid.Row="0"
                 Style="{StaticResource List}"
                 ItemTemplateSelector="{StaticResource ChatSelector}"
                 HorizontalContentAlignment="Stretch"
                 Padding="16,12,16,12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- 输入区（玻璃胶囊） -->
        <Border Grid.Row="1"
                Style="{StaticResource Card.GlassPanel}"
                Margin="16,6,16,0"
                Padding="14,8,10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="TxtTask"
                             Style="{StaticResource Input.Bare}"
                             MaxHeight="150"
                             MinHeight="30"
                             Padding="2,4,2,4"
                             PreviewKeyDown="TxtTask_PreviewKeyDown"
                             TextChanged="TxtTask_TextChanged" />
                    <TextBlock x:Name="TxtTaskHint"
                               Style="{StaticResource Text.Base}"
                               Foreground="{DynamicResource Text.Caption}"
                               IsHitTestVisible="False"
                               Margin="3,5,0,0"
                               Text="发消息，描述要在电脑上完成的任务…" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="BtnModel"
                                  Grid.Column="0"
                                  Style="{StaticResource Chip}"
                                  VerticalAlignment="Center"
                                  Click="BtnModel_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Model}"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </Viewbox>
                            <TextBlock x:Name="TxtModel"
                                       Text="未配置模型"
                                       FontSize="13"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Button x:Name="BtnSend"
                            Grid.Column="2"
                            Style="{StaticResource Btn.CircleSend}"
                            ToolTip="发送（Enter）"
                            Click="BtnSend_Click">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Icon.OnPrimary}" Data="{StaticResource Icon.Send}" />
                        </Viewbox>
                    </Button>

                    <Button x:Name="BtnStop"
                            Grid.Column="2"
                            Style="{StaticResource Btn.CircleStop}"
                            Visibility="Collapsed"
                            ToolTip="停止任务"
                            Click="BtnStop_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource Icon.Stop}" Stretch="Uniform" Fill="{DynamicResource Status.Error}" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource Text.Tiny}"
                   Margin="24,8,24,10"
                   Text="内容由 AI 生成，请注意甄别" />
    </Grid>
</UserControl>
