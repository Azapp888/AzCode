<UserControl x:Class="AzCode.Desktop.Pages.SkillsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="SkillRow">
            <Border Style="{StaticResource Card.Field}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="{Binding Title}" />
                        <TextBlock x:Name="Desc"
                                   Style="{StaticResource Text.Secondary}"
                                   Margin="0,4,0,0"
                                   Text="{Binding Skill.Description}" />
                        <TextBlock x:Name="Detail"
                                   Style="{StaticResource Text.Mono}"
                                   Margin="0,8,0,0"
                                   MaxHeight="180"
                                   Text="{Binding Skill.Content}" />
                        <TextBlock x:Name="Src"
                                   Style="{StaticResource Text.Tiny}"
                                   Margin="0,6,0,0"
                                   Text="{Binding Skill.Source}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <CheckBox IsChecked="{Binding Skill.Enabled, Mode=OneWay}"
                                  Style="{StaticResource Switch}"
                                  Margin="0,2,10,0"
                                  Click="ToggleSkill_Click"
                                  ToolTip="启用后会注入 Agent 上下文" />
                        <ToggleButton Content="详情"
                                      Style="{StaticResource Chip}"
                                      FontSize="12"
                                      Padding="10,5,10,5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowDetail}" />
                        <Button Content="删除"
                                Style="{StaticResource Btn.Text}"
                                FontSize="12"
                                Foreground="{DynamicResource Status.Error}"
                                Click="DeleteSkill_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowDetail}" Value="False">
                    <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Skill.Source}" Value="">
                    <Setter TargetName="Src" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Skill.Description}" Value="">
                    <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.BarTitle}" Text="技能管理" VerticalAlignment="Center" />
            <ToggleButton x:Name="BtnNewSkill"
                          Grid.Column="1"
                          Style="{StaticResource Chip}"
                          Content="新建自定义技能"
                          VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="0"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Stroke.Divider}" />

        <Border Grid.Row="1"
                Style="{StaticResource Card.Field}"
                Margin="16,12,16,0"
                MaxWidth="760"
                HorizontalAlignment="Left"
                Visibility="{Binding IsChecked, ElementName=BtnNewSkill, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.RowTitle}" Text="技能名称" Margin="0,0,0,6" />
                <TextBox x:Name="TxtSkillName" Style="{StaticResource Input.Base}" />
                <TextBlock Style="{StaticResource Text.RowTitle}" Margin="0,12,0,6" Text="简介（一句话说明用途）" />
                <TextBox x:Name="TxtSkillDesc" Style="{StaticResource Input.Base}" />
                <TextBlock Style="{StaticResource Text.RowTitle}" Margin="0,12,0,6" Text="提示词内容" />
                <TextBox x:Name="TxtSkillContent" Style="{StaticResource Input.Multiline}" MinHeight="110" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
                    <Button Style="{StaticResource Btn.Primary}" Content="保存技能" Width="120" Click="SaveSkill_Click" />
                    <Button Style="{StaticResource Btn.Text}" Margin="10,0,0,0" VerticalAlignment="Center" Content="取消" Click="CancelNew_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.SectionLabel}" Text="从 GitHub 安装" />
                <Border Style="{StaticResource Card.Field}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallUrl"
                                 Style="{StaticResource Input.Base}"
                                 Tag="SKILL.md 链接或仓库地址，例如 https://github.com/owner/repo" />
                        <Button x:Name="BtnInstall"
                                Grid.Column="2"
                                Style="{StaticResource Btn.Primary}"
                                Content="安装"
                                Width="88"
                                Click="Install_Click" />
                    </Grid>
                </Border>
                <TextBlock x:Name="TxtMsg"
                           Style="{StaticResource Text.Caption}"
                           Margin="4,8,0,0" />

                <TextBlock Style="{StaticResource Text.SectionLabel}" Text="已安装技能" Margin="4,20,0,8" />
                <TextBlock x:Name="TxtEmpty"
                           Style="{StaticResource Text.Caption}"
                           Text="还没有技能。"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="SkillList" ItemTemplate="{StaticResource SkillRow}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
