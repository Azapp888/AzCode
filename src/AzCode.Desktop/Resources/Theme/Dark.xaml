<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗色令牌，与 Android values-night/colors.xml 同名等价；
         玻璃色 Android 未提供 night 覆盖，桌面端按暗色底重定义。 -->

    <SolidColorBrush x:Key="Brand.Primary" Color="#5686FE" />
    <SolidColorBrush x:Key="Brand.Pressed" Color="#679EFE" />
    <SolidColorBrush x:Key="Brand.Soft" Color="#1E2A46" />
    <SolidColorBrush x:Key="Brand.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brand.OnPrimaryMuted" Color="#DCE4FF" />

    <SolidColorBrush x:Key="Surface.Background" Color="#151517" />
    <SolidColorBrush x:Key="Surface.Card" Color="#232324" />
    <SolidColorBrush x:Key="Surface.Muted" Color="#1B1B1C" />
    <SolidColorBrush x:Key="Surface.Input" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Surface.Drawer" Color="#1B1B1C" />
    <SolidColorBrush x:Key="Surface.Attach" Color="#232324" />

    <SolidColorBrush x:Key="Text.Primary" Color="#F9FAFB" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#CFD3D6" />
    <SolidColorBrush x:Key="Text.Caption" Color="#81858C" />

    <SolidColorBrush x:Key="Stroke.Subtle" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Stroke.Divider" Color="#1FFFFFFF" />

    <SolidColorBrush x:Key="Bubble.Assistant" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Bubble.User" Color="#5686FE" />

    <SolidColorBrush x:Key="Tool.Background" Color="#232324" />
    <SolidColorBrush x:Key="Tool.Border" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Tool.Text" Color="#CFD3D6" />

    <SolidColorBrush x:Key="Status.On" Color="#4ED17E" />
    <SolidColorBrush x:Key="Status.Off" Color="#5A5D63" />
    <SolidColorBrush x:Key="Status.Error" Color="#F25A5A" />
    <SolidColorBrush x:Key="Status.ErrorBg" Color="#3A1D1D" />
    <SolidColorBrush x:Key="Status.ErrorBorder" Color="#6B2B2B" />

    <SolidColorBrush x:Key="Glass.Surface" Color="#E626272A" />
    <SolidColorBrush x:Key="Glass.SurfaceStrong" Color="#F22B2C2F" />
    <SolidColorBrush x:Key="Glass.Stroke" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Glass.Scrim" Color="#99000000" />

    <SolidColorBrush x:Key="Nav.Selected" Color="#1E2A46" />
    <SolidColorBrush x:Key="Interact.Hover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Interact.Pressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Interact.PressedOnPrimary" Color="#33FFFFFF" />

    <Color x:Key="Brand.PrimaryColor">#5686FE</Color>
    <Color x:Key="Surface.BackgroundColor">#151517</Color>

</ResourceDictionary>
