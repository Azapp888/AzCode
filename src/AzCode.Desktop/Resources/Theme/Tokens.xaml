<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 尺寸 / 圆角 / 字号令牌：与 Android 设计清单第 1.7 ~ 1.9 节一致 -->

    <CornerRadius x:Key="Radius.Button" UniformRadii="10" />
    <CornerRadius x:Key="Radius.Field" UniformRadii="10" />
    <CornerRadius x:Key="Radius.Input" UniformRadii="12" />
    <CornerRadius x:Key="Radius.Tool" UniformRadii="12" />
    <CornerRadius x:Key="Radius.Card" UniformRadii="16" />
    <CornerRadius x:Key="Radius.Chip" UniformRadii="16" />
    <CornerRadius x:Key="Radius.NavItem" UniformRadii="22" />
    <CornerRadius x:Key="Radius.Composer" UniformRadii="24" />
    <CornerRadius x:Key="Radius.Panel" UniformRadii="26" />

    <!-- RoundedBorder 的四角半径：Left=左上 Top=右上 Right=右下 Bottom=左下 -->
    <Thickness x:Key="Radii.BubbleAssistant" Left="16" Top="16" Right="16" Bottom="4" />
    <Thickness x:Key="Radii.BubbleUser" Left="16" Top="16" Right="4" Bottom="16" />

    <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, PingFang SC, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <x:Double x:Key="Size.TopBar">56</x:Double>
    <x:Double x:Key="Size.SideBar">260</x:Double>
    <x:Double x:Key="Size.ChatMax">820</x:Double>
    <x:Double x:Key="Size.Icon">20</x:Double>
    <x:Double x:Key="Size.IconButton">38</x:Double>
    <x:Double x:Key="Font.Body">15</x:Double>
    <x:Double x:Key="Font.Small">13</x:Double>
    <x:Double x:Key="Font.Caption">12</x:Double>
    <x:Double x:Key="Font.Tiny">11</x:Double>
    <x:Double x:Key="Font.Micro">10</x:Double>

    <Thickness x:Key="Pad.Page" Left="16" Top="16" Right="16" Bottom="16" />
    <Thickness x:Key="Pad.Bubble" Left="14" Top="10" Right="14" Bottom="11" />
    <Thickness x:Key="Pad.Field" Left="14" Top="12" Right="14" Bottom="12" />
    <Thickness x:Key="Pad.Row" Left="14" Top="12" Right="14" Bottom="12" />

</ResourceDictionary>
