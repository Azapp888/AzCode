<Window x:Class="AzCode.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AzCode"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        Background="{DynamicResource Surface.Background}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="Padding" Value="7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Border Background="{DynamicResource Surface.Background}"
            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource Surface.Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/app.png" Width="18" Height="18" />
                    <TextBlock Text="AzCode"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>

                <Button x:Name="BtnTheme"
                        Grid.Column="1"
                        Style="{StaticResource Btn.Caption}"
                        Width="80"
                        Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnTheme_Click"
                        ToolTip="切换明暗主题">
                    <TextBlock x:Name="TxtTheme"
                               Style="{StaticResource Text.Value}"
                               Text="暗色" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource Btn.Caption}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnMin_Click"
                        ToolTip="最小化">
                    <Path Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Text.Secondary}"
                          StrokeThickness="1.2"
                          Data="M 0,8 L 8,8" />
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource Btn.Caption}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnMax_Click"
                        ToolTip="最大化 / 还原">
                    <Rectangle Width="11"
                               Height="11"
                               Stroke="{DynamicResource Text.Secondary}"
                               StrokeThickness="1.2"
                               RadiusX="2"
                               RadiusY="2" />
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource Btn.CaptionClose}"
                        Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnClose_Click"
                        ToolTip="关闭">
                    <Path Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Text.Secondary}"
                          StrokeThickness="1.2"
                          Data="M 0,0 L 8,8 M 8,0 L 0,8" />
                </Button>
            </Grid>

            <!-- 侧边栏 + 内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource Surface.Drawer}"
                        BorderBrush="{DynamicResource Stroke.Divider}"
                        BorderThickness="0,1,1,0"
                        Padding="14,10,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource Text.H1}" Text="AzCode" />

                            <Button x:Name="BtnNewChat"
                                    Style="{StaticResource Btn.Outline}"
                                    Margin="0,14,0,0"
                                    Click="BtnNewChat_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Add}"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Viewbox>
                                    <TextBlock Text="新建对话"
                                               FontSize="14"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource Text.Caption}" Text="工作台" Margin="6,18,0,6" />

                            <RadioButton x:Name="NavChat" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="chat" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Nav}" Data="{StaticResource Icon.Prompt}" />
                                    </Viewbox>
                                    <TextBlock Text="对话" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSkills" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="skills" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Nav}" Data="{StaticResource Icon.Skill}" />
                                    </Viewbox>
                                    <TextBlock Text="技能" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavGithub" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="github" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Nav}" Data="{StaticResource Icon.Code}" />
                                    </Viewbox>
                                    <TextBlock Text="GitHub" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="settings" Margin="0,4,0,0" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Nav}" Data="{StaticResource Icon.Settings}" />
                                    </Viewbox>
                                    <TextBlock Text="设置" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Border Grid.Row="2" Height="1" Margin="6,16,6,12" Background="{DynamicResource Stroke.Divider}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" Text="最近会话" Margin="6,0,0,6" />

                        <StackPanel Grid.Row="4">
                            <TextBlock x:Name="TxtSessionsEmpty"
                                       Style="{StaticResource Text.Tiny}"
                                       Margin="6,2,0,0"
                                       Text="多会话管理即将上线，当前保留一份连续历史。" />
                        </StackPanel>

                        <TextBlock Grid.Row="5"
                                   x:Name="TxtVersion"
                                   Style="{StaticResource Text.Tiny}"
                                   Margin="6,8,0,0"
                                   Text="magic 0.1.0" />
                     </Grid>
                </Border>

                <ContentControl x:Name="ContentHost" Grid.Column="1" />
            </Grid>
        </Grid>
    </Border>
</Window>
