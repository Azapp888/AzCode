<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮助理光晕（叠加在其它应用之上，背景透明）。
  左下角是一个悬浮气泡卡片：状态行 + 可读的识别/回复文字 + 波动条；
  屏幕物理边缘由 AssistOrbView 绘制呼吸蓝光（与 AI 操作手机的边缘光同构），画面中间不绘制任何动画。
  其余区域全部透明，当前页面照常显示。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <app.azcode.bridge.AssistOrbView
        android:id="@+id/overlayOrb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_assist_bubble"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="13dp"
        android:paddingEnd="17dp"
        android:paddingBottom="13dp">

        <TextView
            android:id="@+id/tvOverlayState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assist_listening"
            android:textColor="#A9C3FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOverlayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="6"
            android:maxWidth="288dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <app.azcode.bridge.VoiceWaveView
            android:id="@+id/overlayWave"
            android:layout_width="180dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</FrameLayout>