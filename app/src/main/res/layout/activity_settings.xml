<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_glass"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/btn_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_account" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/rowModel"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_model" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/title_providers" />

                    <TextView
                        android:id="@+id/tvModelEntry"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_value_unset" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowGithub"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_code" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/title_github" />

                    <TextView
                        android:id="@+id/tvGithubEntry"
                        style="@style/SettingsRowValue"
                        android:text="@string/settings_value_not_connected" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SectionLabel" android:text="@string/section_app" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/rowSkills"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_skill" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/title_skills" />

                    <TextView
                        android:id="@+id/tvSkillsEntry"
                        style="@style/SettingsRowValue" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowMemory"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_memory" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/title_memory" />

                    <TextView
                        android:id="@+id/tvMemoryEntry"
                        style="@style/SettingsRowValue" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowLogs"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_prompt" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/title_logs" />

                    <TextView
                        android:id="@+id/tvLogsEntry"
                        style="@style/SettingsRowValue" />

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow" android:clickable="false" android:focusable="false">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_step" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/hint_max_steps" />

                    <EditText
                        android:id="@+id/etMaxSteps"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="@string/settings_value_unset"
                        android:inputType="number"
                        android:textColor="@color/text_secondary"
                        android:textColorHint="@color/text_caption"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow" android:clickable="false" android:focusable="false">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_image" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_image_watermark"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/hint_image_watermark_desc"
                            android:textColor="@color/text_caption"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swImageWatermark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_prompt" />

                        <TextView style="@style/SettingsRowTitle" android:text="@string/hint_system_prompt" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etSystemPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:gravity="top"
                        android:hint="@string/hint_system_prompt_placeholder"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_caption"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_save_config"
                android:textColor="@color/text_on_primary"
                android:textSize="15sp" />

            <TextView style="@style/SectionLabel" android:text="@string/section_capabilities" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAccessibility"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="@string/btn_open_accessibility"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnShizuku"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="@string/btn_request_shizuku"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnTermux"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="@string/btn_termux"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBridge"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="@string/btn_start_bridge"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnMode"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="@string/btn_cycle_mode"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SectionLabel" android:text="@string/section_about" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout style="@style/SettingsRow" android:clickable="false" android:focusable="false">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_info" />

                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_version" />

                    <TextView
                        android:id="@+id/tvVersion"
                        style="@style/SettingsRowValue" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
