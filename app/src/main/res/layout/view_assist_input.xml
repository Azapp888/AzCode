<?xml version="1.0" encoding="utf-8"?>
<!-- 智能助理的键盘输入条：底部可聚焦窗口，弹出系统输入法直接键入指令 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_assist_bubble"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <EditText
        android:id="@+id/etAssistInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_assist_field"
        android:hint="@string/ask_input_hint"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:maxLines="4"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#80FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnAssistSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_assist_option"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:text="@string/ask_send"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>